# PostgreSQL local-development values. Do not use these defaults in production.
POSTGRES_DB=keystone
POSTGRES_USER=keystone
POSTGRES_PASSWORD=keystone_local_dev
POSTGRES_PORT=5433

# Backend local-development configuration.
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5433/keystone
DB_USERNAME=keystone
DB_PASSWORD=keystone_local_dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend local-development configuration.
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# Production-only switches. Production database credentials have no defaults.
OPENAPI_ENABLED=false
