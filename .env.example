# Copy this file to .env and fill in real values. NEVER commit .env.
# docker-compose reads these; sensible local defaults are already baked into
# docker-compose.yml, so you only need a .env if you want to override them.

# --- Database (local) ---
POSTGRES_DB=keystone
POSTGRES_USER=keystone
POSTGRES_PASSWORD=keystone

# --- Backend ---
# Full JDBC URL used by Spring when running the backend container.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/keystone
SPRING_DATASOURCE_USERNAME=keystone
SPRING_DATASOURCE_PASSWORD=keystone
# Use a long random string in any non-local environment (openssl rand -base64 48).
JWT_SECRET=local-dev-secret-please-change-this-to-a-long-random-value-0123456789
JWT_EXPIRATION_MINUTES=120
# Comma-separated list of allowed browser origins for CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend (baked in at build time by Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api
